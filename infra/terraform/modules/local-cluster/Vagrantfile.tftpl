# SINH TỰ ĐỘNG bởi Terraform (module local-cluster). KHÔNG sửa tay.
Vagrant.configure("2") do |config|
  config.vm.box = "${box}"
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/vagrant", disabled: true
%{ for name, n in nodes ~}

  config.vm.define "${name}" do |m|
    m.vm.hostname = "${name}"
    m.vm.network "private_network", ip: "${n.ip}"
    m.vm.provider "virtualbox" do |vb|
      vb.name = "${project}-${name}"
      vb.cpus = ${n.cpus}
      vb.memory = ${n.memory}
    end
    m.vm.provision "shell", name: "authorize-key", inline: <<-SHELL
      set -e
      KEY='${ssh_public_key}'
      grep -qxF "$KEY" /home/vagrant/.ssh/authorized_keys || echo "$KEY" >> /home/vagrant/.ssh/authorized_keys
    SHELL
%{ if n.role == "control" ~}
    m.vm.provision "file", name: "upload-private-key", source: ".keys/id_ed25519", destination: "/tmp/id_ed25519"
    m.vm.provision "shell", name: "setup-control", inline: <<-SHELL
      set -e
      install -m 600 -o vagrant -g vagrant /tmp/id_ed25519 /home/vagrant/.ssh/id_ed25519
      rm -f /tmp/id_ed25519
      echo '${ssh_public_key}' > /home/vagrant/.ssh/id_ed25519.pub
      chown vagrant:vagrant /home/vagrant/.ssh/id_ed25519.pub
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -y
      apt-get install -y ansible
    SHELL
    m.vm.provision "file", name: "upload-ansible", source: "${ansible_dir}/", destination: "/home/vagrant/ansible"
%{ endif ~}
  end
%{ endfor ~}
end
