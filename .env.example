# Copy thành .env rồi đổi giá trị. KHÔNG commit .env
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=attendance
ADMIN_API_KEY=change-me-admin-key
QR_SECRET=change-me-long-random-string
QR_TTL_SECONDS=45
# Điện thoại sinh viên phải truy cập được địa chỉ này (dùng IP LAN, vd http://192.168.1.10:8080)
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO

# monitoring (optional)
GRAFANA_ADMIN_PASSWORD=change-me
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
